# Groq
GROQ_API_KEY=your-groq-api-key-here

# API security
RETAILOPS_API_KEY=replace-with-a-secure-api-key

# API
RETAILOPS_API_TITLE=RetailOps AI API
RETAILOPS_API_VERSION=1.0.0
RETAILOPS_API_DEBUG=false

# CORS
RETAILOPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Interactive API documentation
# Must be false in production.
RETAILOPS_API_DOCS_ENABLED=true